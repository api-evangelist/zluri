  "item": [
    {
      "id": "136a5d7d-ce79-4a17-83d7-f1cbdce0d7c0",
      "name": "Data Upload",
      "description": {
        "content": "Upload snapshot and fact data within a sync session. Snapshot data represents current state, while fact data represents historical events. Data must be uploaded in paginated batches of up to 1000 records per page.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d3d49614-7d18-4b4b-9a4f-db216ee9240a",
          "name": "Zluri Upload Snapshot Data",
          "request": {
            "name": "Zluri Upload Snapshot Data",
            "description": {
              "content": "Upload snapshot entity data within an active sync session. Snapshot data represents the current state of entities. Zluri compares new snapshots with the previous state to identify changes such as new users, deactivated users, and role changes. Data must be sent in paginated batches of up to 1000 records per page. Re-uploading a page with the same page number during an active sync will overwrite the previous data for that page. Supported entities include users, applications, contracts, and transactions. Follow the dependency order: users, then groups, then group_users, then activities.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "integrations-sync",
                "instances",
                ":instance_id",
                "syncs",
                ":sync_id",
                "data",
                "snapshots"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "instance_id",
                  "description": "(Required) The unique identifier of the integration instance."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sync_id",
                  "description": "(Required) The unique identifier of the sync session."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"<string>\",\n  \"page\": \"<integer>\",\n  \"data\": [\n    \"<object>\",\n    \"<object>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
