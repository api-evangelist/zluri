    {
      "id": "2f9fc0c7-094d-48ff-9712-f2db2230237e",
      "name": "Syncs",
      "description": {
        "content": "Create and manage sync sessions for uploading data to Zluri. A sync must be created before uploading data, and finished after all data is uploaded.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b5dc99d6-6c33-4bb2-b3f4-f88803963412",
          "name": "Zluri Create Sync",
          "request": {
            "name": "Zluri Create Sync",
            "description": {
              "content": "Create a new sync session for the specified instance. Only one sync can be active per instance at a time. Unfinished syncs block new syncs for the same instance. Data uploaded during a sync will not appear in Zluri until the sync is finished.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "integrations-sync",
                "instances",
                ":instance_id",
                "syncs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "instance_id",
                  "description": "(Required) The unique identifier of the integration instance."
                }
              ]
            },
            "header": [
